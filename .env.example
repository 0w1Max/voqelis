# Telegram bot token from @BotFather
BOT_TOKEN=your-token-from-BotFather

# Security: comma-separated Telegram user IDs allowed to use the bot.
# Use /id in the bot to learn your own Telegram user ID.
# Empty = nobody except /id can use the bot.
ALLOWED_USER_IDS=

# Whisper profile for a VPS with 1 vCPU / 2 GB RAM.
# "small" can improve transcription quality, but uses substantially more RAM.
MODEL_SIZE=base
MODEL_DEVICE=cpu
MODEL_COMPUTE_TYPE=int8
CPU_THREADS=1

# Language: ru, en, etc. Empty/auto = language detection.
LANGUAGE=ru

# Quality/speed tuning.
BEAM_SIZE=5
VAD_MIN_SILENCE_MS=500
CONDITION_ON_PREVIOUS_TEXT=true

# Telegram currently allows bots to download files up to 20 MB.
MAX_FILE_SIZE_MB=20
MAX_AUDIO_MINUTES=20

# Back-pressure. One worker is intentional on a 1 vCPU VPS.
MAX_PENDING_JOBS=4
MAX_PENDING_PER_USER=2
DOWNLOAD_TIMEOUT_SECONDS=60

# LOG_LEVEL controls application logging.
# On production systemd deployments, do not add TEMP_DIR or MODEL_CACHE_DIR
# here. The bundled systemd unit supplies protected writable paths under
# /run/voqelis and /var/lib/voqelis.
LOG_LEVEL=INFO


# Planner
# Daily planning uses Moscow time (Europe/Moscow).
# Optional path to the editable planner rules/template file.
PLANNER_CONFIG_PATH=./config/planner.json
# In production systemd maps this to /var/lib/voqelis/planner.sqlite3.
PLANNER_DB_PATH=./data/planner.sqlite3

# Planner AI
# Primary: Groq + Qwen. Fallback: Gemini.
# The bot switches automatically on a primary quota/rate-limit, timeout,
# or invalid structured response. The switch is internal and transparent.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

PLANNER_AI_TIMEOUT_SECONDS=30

# Temporary Planner debug logging. Logs transcribed user text and structured planner proposals.
# Keep false outside debugging because planner content can contain personal information.
PLANNER_LOG_CONTENT=false
